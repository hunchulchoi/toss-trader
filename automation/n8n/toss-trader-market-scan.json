    {"parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"id": "hermes-ok-condition", "leftValue": "={{ $json.ok ? 1 : 0 }}", "rightValue": 1, "operator": {"type": "number", "operation": "equals"}}], "combinator": "and"}, "options": {}}, "id": "hermes-ok", "name": "Hermes 의견 정상?", "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1480, 20]},
