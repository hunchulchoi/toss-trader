# Documentation only. Do not store real values here; inject with Infisical.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ACCOUNT_SEQ=
TOSS_API_BASE_URL=https://openapi.tossinvest.com
TRADING_ENABLED=false
PAPER_DB_PATH=data/paper.db
MARKET_DB_PATH=data/market.db
KIS_APP_KEY=
KIS_APP_SECRET=
