      "targets": [{"datasource": {"type": "grafana-postgresql-datasource", "uid": "toss-postgres"}, "editorMode": "code", "format": "time_series", "rawQuery": true, "rawSql": "WITH candles AS (SELECT timestamp AS time, symbol, close_price, FIRST_VALUE(close_price) OVER (PARTITION BY symbol ORDER BY timestamp) AS base_price FROM market_candles WHERE interval = '1m' AND symbol IN (${trade_symbol:sqlstring}) AND $__timeFilter(timestamp)) SELECT c.time, (((c.close_price / NULLIF(c.base_price, 0)) - 1) * 100)::double precision AS value, COALESCE(s.display_name || ' (' || c.symbol || ')', c.symbol) AS metric FROM candles c LEFT JOIN market_symbols s ON s.symbol = c.symbol ORDER BY c.time", "refId": "A", "sql": {"columns": [{"parameters": [], "type": "function"}], "groupBy": [{"property": {"type": "string"}, "type": "groupBy"}], "limit": 50}}, {"datasource": {"type": "grafana-postgresql-datasource", "uid": "toss-postgres"}, "editorMode": "code", "format": "time_series", "rawQuery": true, "rawSql": "WITH bases AS (SELECT symbol, (ARRAY_AGG(close_price ORDER BY timestamp))[1] AS base_price FROM market_candles WHERE interval = '1m' AND symbol IN (${trade_symbol:sqlstring}) AND $__timeFilter(timestamp) GROUP BY symbol) SELECT f.executed_at AS time, (((f.price / NULLIF(b.base_price, 0)) - 1) * 100)::double precision AS value, COALESCE(s.display_name || ' (' || f.symbol || ')', f.symbol) || ' · ' || COALESCE(p.display_name, f.portfolio_id) || ' ' || f.side AS metric FROM paper_fills f JOIN bases b ON b.symbol = f.symbol LEFT JOIN market_symbols s ON s.symbol = f.symbol LEFT JOIN paper_portfolios p ON p.portfolio_id = f.portfolio_id WHERE f.symbol IN (${trade_symbol:sqlstring}) AND $__timeFilter(f.executed_at) ORDER BY f.executed_at", "refId": "B", "sql": {"columns": [{"parameters": [], "type": "function"}], "groupBy": [{"property": {"type": "string"}, "type": "groupBy"}], "limit": 50}}],
