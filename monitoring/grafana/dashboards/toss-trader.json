      "targets": [{"datasource": {"type": "grafana-postgresql-datasource", "uid": "toss-postgres"}, "editorMode": "code", "format": "time_series", "rawQuery": true, "rawSql": "SELECT r.started_at AS time, v.value::double precision AS value, p.display_name || ' · ' || v.metric AS metric FROM paper_cycle_runs r JOIN paper_portfolios p ON p.portfolio_id = r.portfolio_id CROSS JOIN LATERAL (VALUES ('Symbols', r.symbol_count), ('Signals', r.signal_count), ('Fills', r.fill_count), ('Failures', r.failed_count), ('API Errors', r.consecutive_api_errors)) v(metric, value) WHERE r.portfolio_id IN ('rule', 'hermes') AND $__timeFilter(r.started_at) ORDER BY 1", "refId": "A", "sql": {"columns": [{"parameters": [], "type": "function"}], "groupBy": [{"property": {"type": "string"}, "type": "groupBy"}], "limit": 50}}],
